<!--
  Compile-checks the package's Editor scripts with C# 7.3 (the Unity 2019.4 language level)
  against a Unity install's assemblies, without opening Unity (batch mode needs a signed-in
  Unity Hub license). Unity ignores folders ending in "~", so this never ships in the package.

  Unity 2020.2+ code path:
    dotnet build -p:CheckTfm=netstandard2.1 "-p:CheckDefines=UNITY_EDITOR%3BUNITY_2020_2_OR_NEWER"
  Pre-2020.2 (2019.4) code path:
    dotnet build -p:CheckTfm=netstandard2.0 -p:CheckDefines=UNITY_EDITOR
  (The 2019 path reports CS0618 for isNetworkError/isHttpError because the 2021 DLLs mark them
  obsolete; they are not obsolete on 2019.)
  Another Unity version: -p:UnityManaged="C:/Program Files/Unity/Hub/Editor/<ver>/Editor/Data/Managed/UnityEngine"
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CheckTfm Condition="'$(CheckTfm)' == ''">netstandard2.1</CheckTfm>
    <CheckDefines Condition="'$(CheckDefines)' == ''">UNITY_EDITOR;UNITY_2020_2_OR_NEWER</CheckDefines>
    <UnityManaged Condition="'$(UnityManaged)' == ''">C:/Program Files/Unity/Hub/Editor/2021.3.18f1/Editor/Data/Managed/UnityEngine</UnityManaged>
    <TargetFramework>$(CheckTfm)</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(CheckDefines)</DefineConstants>
    <BaseOutputPath>$(TEMP)/onairdeck-compilecheck/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(TEMP)/onairdeck-compilecheck/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Editor/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(UnityManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(UnityManaged)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(UnityManaged)/UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="$(UnityManaged)/UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="$(UnityManaged)/UnityEditor.CoreModule.dll" Private="false" />
    <Reference Include="$(UnityManaged)/UnityEditor.dll" Private="false" />
  </ItemGroup>
</Project>
